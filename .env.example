# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=app

DATABASE_URL=

# MinIO
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=my-bucket
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false

# Auth
JWT_SECRET=

# Role assignment (existing LDAP usernames)
ADMIN_USER=
# Optional comma-separated LDAP usernames; admins can also verify
VERIFIER_USERS=

# LDAP (required for login)
LDAP_SERVER=
LDAP_DOMAIN=
# Reserved for a future LDAP search; NTLM login currently does not use it
BASE_DN=

# Public Traefik instance (used by docker-compose.traefik.yml)
TRAEFIK_ACME_EMAIL=
